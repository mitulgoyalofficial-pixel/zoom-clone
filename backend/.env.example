# Copy to backend/.env (never commit the real .env)

# Where the Next.js frontend runs. Used for CORS and to build invite links.
FRONTEND_URL=http://localhost:3000

# Which database to use. Leave it out locally: the default is a SQLite file (zoom.db) next to where
# uvicorn is started. When deployed on Vercel, the Neon integration sets this to a Postgres address
# (postgresql://user:password@host/dbname?sslmode=require); the code adapts it for the installed driver.
# DATABASE_URL=sqlite:///./zoom.db
